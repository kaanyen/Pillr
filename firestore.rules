rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isAuthenticated()
 && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/user_church_index/$(request.auth.uid)).data;
    }

    function getUserChurchId() {
      return getUserData().churchId;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    function isAdmin() { return isRole('admin'); }
    function isPastor() { return isRole('pastor'); }
    function isStaff() { return isRole('staff'); }
    function isPastorOrAdmin() { return isAdmin() || isPastor(); }

    // Sub-arms are one level deep: an arm may name a main arm to count toward,
    // never itself, and only one that is not a sub-arm already. Read after the
    // write, because a rearrangement is one batch that can promote the main
    // arm in the same commit. Whether an arm
    // that has sub-arms is being made a sub-arm can't be seen from here (it
    // needs a query); the app refuses that move before it writes.
    function validArmParent(churchId, armId) {
      let parent = request.resource.data.get('parentArmId', null);
      return parent == null
          || (parent is string && parent != armId
              && existsAfter(/databases/$(database)/documents/churches/$(churchId)/partnership_arms/$(parent))
              && getAfter(/databases/$(database)/documents/churches/$(churchId)/partnership_arms/$(parent))
                   .data.get('parentArmId', null) == null);
    }
    function isPastorOrStaff() { return isPastor() || isStaff(); } // used in UI guards
    function settingsOf(data) {
      return data.keys().hasAny(['settings']) && data.settings is map
             ? data.settings
             : {};
    }

    // A partner field that this write changes only in capitals or spacing.
    function sameIgnoringCase(field) {
      return request.resource.data.get(field, '').lower().trim()
             == resource.data.get(field, '').lower().trim();
    }

    // A partner's member ID changes only with the old one added to
    // formerMemberIds, so receipts, sheets and searches by it still find them.
    function keepsOldMemberId() {
      let after = request.resource.data;
      let keys = after.diff(resource.data).affectedKeys();
      let oldId = resource.data.get('memberId', '');
      return (!keys.hasAny(['memberId']) && !keys.hasAny(['formerMemberIds']))
          || (keys.hasAny(['memberId']) && oldId == ''
              && !keys.hasAny(['formerMemberIds']))
          || (keys.hasAll(['memberId', 'formerMemberIds']) && oldId != ''
              && after.formerMemberIds
                   == resource.data.get('formerMemberIds', []).concat([oldId]));
    }
    function belongsToChurch(churchId) {
      return isAuthenticated() && getUserChurchId() == churchId;
    }

    function isOwnEntry(entry) {
      return entry.createdBy == request.auth.uid;
    }

    // Voiding reverses money that was already counted, so it is not an
    // ordinary edit. Pastor and admin may put an entry into or out of the
    // voided state. Staff may void from Tools (duplicate entries) with a
    // field-restricted write below.
    function writesVoidState(before, after) {
      return before.status == 'voided' || after.status == 'voided';
    }

    match /user_church_index/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if false;
    }

    match /platform_admins/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    match /church_bootstrap_invites/{inviteId} {
      allow read, write: if false;
    }

    match /platform_audit_logs/{logId} {
      allow read, write: if false;
    }

    match /churches/{churchId} {
      allow read: if isPlatformAdmin() || belongsToChurch(churchId);

      // A church may edit how it looks and how it is set up. It may not edit
      // whether it is allowed to exist: `isActive` is the platform's switch,
      // and until this was field-restricted a suspended church's own pastor
      // could turn it back on. Suspension runs through the setChurchActive
      // callable, which uses the admin SDK and does not pass through rules.
      //
      // Creation and deletion of a church stay with the platform for the same
      // reason.
      allow create, delete: if false;
      allow update: if belongsToChurch(churchId) && isPastorOrAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'primaryColorHex', 'logoUrl',
                                   'logoStoragePath', 'currency',
                                   'currencySymbol', 'settings',
                                   'churchSetupCompletedAt', 'updatedAt']);
      // Staff may rewrite the fellowship book and exchange rates — not
      // branding or monthly email settings.
      allow update: if belongsToChurch(churchId) && isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['settings', 'updatedAt'])
                    && settingsOf(request.resource.data)
                         .diff(settingsOf(resource.data))
                         .affectedKeys()
                         .hasOnly(['fellowshipNames', 'exchangeRates']);

      match /users/{uidField} {
        allow read: if belongsToChurch(churchId) && isPastorOrAdmin();
        allow read: if request.auth.uid == uidField;
        allow create: if false;
        allow update: if belongsToChurch(churchId) && (isAdmin() || request.auth.uid == uidField);
        allow delete: if belongsToChurch(churchId) && isAdmin();
      }

      match /partners/{partnerId} {
        allow read: if belongsToChurch(churchId) && (isPastor() || isStaff() || isAdmin());
        allow create: if belongsToChurch(churchId) && (isPastor() || isStaff());
        // Pastor edits any partner, but not the merge record: merges, fellowship
        // merges and moves run through the fellowshipChange / partnerMerge
        // callables, which record every change so it can be undone.
        allow update: if belongsToChurch(churchId) && isPastor()
                      && !request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['mergedInto', 'mergedBy', 'mergedAt',
                                    'mergedAliases', 'splitFrom'])
                      && keepsOldMemberId();
        // Staff edit a partner's name, member ID, contacts, address and
        // notes. The fellowship may change only in casing — a real move goes
        // through the recorded fellowship move — and staff never close a
        // partner.
        allow update: if belongsToChurch(churchId) && isStaff()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['fullName', 'fullNameLower', 'memberId',
                                     'formerMemberIds', 'email', 'phone',
                                     'phones', 'emails', 'address', 'notes',
                                     'fellowship', 'fellowshipLower',
                                     'updatedAt'])
                      && sameIgnoringCase('fellowship')
                      && keepsOldMemberId();
        // Staff Tools: write recomputed partner totals.
        allow update: if belongsToChurch(churchId) && isStaff()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['totalApprovedAmount', 'totalApprovedPesewas',
                                     'entryCount', 'updatedAt']);
        // A partner is never deleted: their gifts point at them, and a record
        // that vanishes cannot be explained or restored. Close them (isActive)
        // or merge them; both keep the record and can be undone.
        allow delete: if false;
      }

      match /entries/{entryId} {
        allow read: if belongsToChurch(churchId) && isPastorOrStaff();

        // Pastor: may create entries as approved (self-approve) or pending.
        // Field-level review checks are enforced in app code, not rules,
        // because FieldValue.serverTimestamp() is not safely matchable via `is timestamp`
        // at rules-evaluation time when the write is still pending server processing.
        allow create: if belongsToChurch(churchId) && isPastor();

        // Staff: new entries must always be pending and cannot pre-fill review fields.
        allow create: if belongsToChurch(churchId) && isStaff()
                      && request.resource.data.status == 'pending'
                      && request.resource.data.reviewedBy == null
                      && request.resource.data.reviewedAt == null;

        // Pastor: approve, decline, edit any entry.
        allow update: if belongsToChurch(churchId) && isPastor();

        // Admin: may void an entry and may restore one, but has no other say
        // over an entry's content — that stays with the pastor.
        allow update: if belongsToChurch(churchId) && isAdmin()
                      && writesVoidState(resource.data, request.resource.data);

        // Staff: edit own pending or declined entries; must reset to pending (re-submit).
        // A voided entry is settled and is not theirs to reopen from the form.
        allow update: if belongsToChurch(churchId) && isStaff()
                      && isOwnEntry(resource.data)
                      && (resource.data.status == 'pending' || resource.data.status == 'declined')
                      && request.resource.data.status == 'pending'
                      && !writesVoidState(resource.data, request.resource.data)
                      && request.resource.data.createdBy == resource.data.createdBy;

        // Staff Tools: void a duplicate entry. Amount and review stay untouched.
        allow update: if belongsToChurch(churchId) && isStaff()
                      && writesVoidState(resource.data, request.resource.data)
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'voidedBy', 'voidedAt', 'voidReason',
                                     'updatedAt', 'editHistory']);

        allow delete: if belongsToChurch(churchId) && isPastor();
        allow delete: if belongsToChurch(churchId) && isStaff()
                      && isOwnEntry(resource.data)
                      && resource.data.status == 'pending';
      }

      match /partnership_arms/{armId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if belongsToChurch(churchId) && isPastorOrAdmin()
                              && validArmParent(churchId, armId);
        allow delete: if belongsToChurch(churchId) && isPastorOrAdmin();
      }

      match /partnership_periods/{periodId} {
        allow read: if belongsToChurch(churchId);
        allow write: if belongsToChurch(churchId) && isPastorOrAdmin();
        // Staff Tools: write recomputed period totals.
        allow update: if belongsToChurch(churchId) && isStaff()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['totalApprovedAmount', 'totalApprovedPesewas',
                                     'entryCount', 'updatedAt']);
      }

      match /goals/{goalId} {
        allow read: if belongsToChurch(churchId) && isPastor();
        allow write: if belongsToChurch(churchId) && isPastor();
      }

      match /invite_codes/{codeId} {
        allow read: if belongsToChurch(churchId) && isPastorOrAdmin();
        allow create: if belongsToChurch(churchId) && isPastorOrAdmin();
        allow update: if false;
        allow delete: if belongsToChurch(churchId) && isPastorOrAdmin();
      }

      match /import_batches/{batchId} {
        // The record of what an import did. Written once by whoever ran it and
        // never deleted — an import you can erase the trace of is not
        // provenance. What it *did* is fixed: the file name, the counts, the
        // total, and who ran it are not in either list below, so no client can
        // rewrite them.
        allow read: if belongsToChurch(churchId) && isPastorOrStaff();
        allow create: if belongsToChurch(churchId) && isPastorOrStaff();

        // Whoever ran it may record that they undid it.
        allow update: if belongsToChurch(churchId) && isPastorOrStaff()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['undoneAt', 'undoneBy', 'removedCount', 'keptCount']);

        // Closing a run that was opened with begin() — counts stay frozen
        // after inProgress flips to false.
        allow update: if belongsToChurch(churchId) && isPastorOrStaff()
                      && resource.data.inProgress == true
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly([
                             'inProgress', 'entryCount', 'partnersCreated',
                             'totalCedis', 'skippedCount',
                           ]);

        // Pastor or admin: the things the Imports screen offers afterwards —
        // naming it, recording who prepared the sheet, moving it to another
        // period, clearing it, and reversing those same actions.
        allow update: if belongsToChurch(churchId) && isPastorOrAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly([
                             'label', 'note', 'preparedBy', 'updatedAt',
                             'previousLabel', 'previousNote',
                             'voidedAt', 'voidedBy', 'voidedCount',
                             'restoredAt', 'restoredBy', 'restoredCount',
                             'reassignedAt', 'reassignedBy', 'reassignedCount',
                             'periodName', 'previousPeriodName',
                             'lastEditedAt', 'lastEditedBy', 'lastEditedCount',
                           ]);

        allow delete: if false;
      }

      match /monthly_email_reports/{reportId} {
        allow read: if belongsToChurch(churchId) && isPastor();
        allow write: if false;
      }

      match /monthly_email_deliveries/{deliveryId} {
        allow read: if belongsToChurch(churchId) && isPastor();
        allow write: if false;
      }

      // Bulk changes and their before/after records. Written only by the
      // record_ops callables; readable so Tools can list and undo them.
      match /operations/{opId} {
        allow read: if belongsToChurch(churchId) && (isPastor() || isStaff() || isAdmin());
        allow write: if false;
        match /changes/{changeId} {
          allow read: if belongsToChurch(churchId) && (isPastor() || isStaff() || isAdmin());
          allow write: if false;
        }
      }

      // Counts from the nightly duplicate check, for the Tools badge.
      match /health/{docId} {
        allow read: if belongsToChurch(churchId) && (isPastor() || isStaff() || isAdmin());
        allow write: if false;
      }

      match /op_locks/{lockId} {
        allow read, write: if false;
      }

      // Pairs someone checked and marked "not the same person", so the
      // duplicate scan stops offering them.
      match /duplicate_dismissals/{pairId} {
        allow read, delete: if belongsToChurch(churchId) && isPastorOrStaff();
        allow create: if belongsToChurch(churchId) && isPastorOrStaff()
                      && request.resource.data.dismissedBy == request.auth.uid;
      }

      match /activity_logs/{logId} {
        // Admin: full audit UI. Pastor: dashboards + transparency (§15).
        allow read: if belongsToChurch(churchId) && (isAdmin() || isPastor());
        allow create: if belongsToChurch(churchId);
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
